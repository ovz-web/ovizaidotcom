# ==============================================================================
# OVIZai Studio — Configuration des Variables d'Environnement
# ==============================================================================
# Renseignez ces variables dans votre tableau de bord Vercel (ou fichier .env.local).
# ATTENTION : Seules les variables préfixées par NEXT_PUBLIC_ sont visibles côté client.
# Toutes les clés secrètes ci-dessous restent strictement confinées aux routes API serveur.

# --- 1. DOMAINE PUBLIC ---
NEXT_PUBLIC_SITE_URL=https://ovizai.com

# --- 2. SUPABASE (Base de données des leads & transactions) ---
# Clés publiques pour initialisation client / CDN
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé de service secrète (NE JAMAIS EXPOSER CÔTÉ CLIENT - utilisée uniquement dans /api/leads et webhooks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- 3. STRIPE (Paiements sécurisés Masterclass) ---
# Clé secrète Stripe (sk_live_... ou sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Secret de signature du Webhook Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- 4. RESEND (Emails transactionnels de confirmation & notification équipe) ---
# Clé API Resend (re_...)
RESEND_API_KEY=re_...
# Adresse expéditeur validée sur Resend (ex: OVIZai <contact@ovizai.com>)
RESEND_SENDER_EMAIL=contact@ovizai.com
# Adresse email interne recevant les briefs clients qualifiés
TEAM_NOTIFICATION_EMAIL=contact@ovizai.com

# --- 5. RATE LIMITING DISTRIBUÉ (Optionnel - Upstash Redis) ---
# Si non configuré, le rate limiting bascule automatiquement sur la mémoire / Supabase
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
